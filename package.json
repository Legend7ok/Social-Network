{
  "name": "social-network",
  "private": true,
  "scripts": {
    "watch:css": "npx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/dist/styles.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/dist/styles.css --minify",
    "copy:vendor": "cp node_modules/htmx.org/dist/htmx.min.js app/static/js/vendor/htmx.min.js && cp node_modules/alpinejs/dist/cdn.min.js app/static/js/vendor/alpine.min.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.5"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.4"
  }
}
