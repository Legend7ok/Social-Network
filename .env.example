# A dollar sign in any value below is read by compose as the start of a variable
# name and dropped, so the container receives a shorter string than written.
# Double it as $$, or pick a value without one.
SECRET_KEY=your_long_secret_key

# The address the site knows itself by: used in emails and in links that leave
# the page. In production it must match the name people actually type.
SITE_URL=http://localhost:8000

# Docker: only needed for a second checkout of this repository, so its
# containers, volumes and database do not collide with the first one.
# PROJECT_NAME=social-network-w2

# PostgreSQL. The first three build the database, the fourth tells Django where
# to find it - they have to agree, or the site starts and finds nothing.
POSTGRES_DB=socialnetwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@db:5432/socialnetwork

# ngrok - required for OAuth callbacks over HTTPS
# Get your token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken

# Add your ngrok URL so Django accepts it and CSRF works over HTTPS
# Example: https://abc123.ngrok-free.app
ALLOWED_HOSTS=localhost,127.0.0.1,<your-ngrok-subdomain>.ngrok-free.app
CSRF_TRUSTED_ORIGINS=https://<your-ngrok-subdomain>.ngrok-free.app

# Production only. Runs the production stack over plain http on this machine:
# no redirect to https, no year-long instruction to browsers to avoid http, and
# cookies allowed over http so signing in works. NEVER set this on a server -
# with it on, passwords and sessions travel in the clear.
# INSECURE_LOCAL_HTTP=true

# Social auth
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your_client_id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your_client_secret
SOCIAL_AUTH_GITHUB_KEY=your_client_id
SOCIAL_AUTH_GITHUB_SECRET=your_client_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required: the container refuses to start without it. Any long random string.
REDIS_PASSWORD=your_redis_password

# Email (Resend SMTP)
# Get API key at: resend.com → API Keys
RESEND_API_KEY=re_your_api_key
DEFAULT_FROM_EMAIL=onboarding@resend.dev
SERVER_EMAIL=onboarding@resend.dev

# Cloudflare R2
# Production always uses the bucket. Development writes uploads to disk instead,
# so the keys below can stay empty; set USE_R2=true to develop against the real
# bucket, and then they are required.
# USE_R2=true
# Get credentials at: dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Optional: enable public access in R2 dashboard and paste the r2.dev subdomain (without https://)
R2_PUBLIC_DOMAIN=pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Gunicorn, production only. Defaults are 5 processes of 2 threads each, which
# is plenty; raise them only if a real load says so. Each process holds its own
# copy of Django, so the count is what decides the memory the web container uses.
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=2
